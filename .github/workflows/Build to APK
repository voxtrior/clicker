name: Build to APK (com.xundao.clicker)

on:
  push:
    branches: [ "*" ]
  workflow_dispatch:

jobs:
  build-apk:
    name: Build & Sign Android APK
    runs-on: ubuntu-latest

    steps:
      - name: 1. Checkout Repository
        uses: actions/checkout@v4

      - name: 2. Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: 3. Setup Gradle 8.4
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: '8.4'

      - name: 4. Locate Project Root & Compile APK
        run: |
          set -e
          SETTINGS_FILE=$(find . -maxdepth 3 -name "settings.gradle.kts" | head -n 1)
          if [ -z "$SETTINGS_FILE" ]; then
            echo "Error: settings.gradle.kts not found in repository!"
            exit 1
          fi
          PROJECT_DIR=$(dirname "$SETTINGS_FILE")
          echo "Found Android project at: $PROJECT_DIR"
          cd "$PROJECT_DIR"

          gradle assembleDebug assembleRelease --no-daemon

          BUILD_TOOLS_DIR=$(ls -d "$ANDROID_HOME"/build-tools/* | sort -V | tail -n 1)
          echo "Using Android build-tools: $BUILD_TOOLS_DIR"

          keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 \
            -alias xundao -storepass 123456 -keypass 123456 \
            -dname "CN=Xundao, OU=Mobile, O=Xundao, L=Jinan, ST=Shandong, C=CN"

          "$BUILD_TOOLS_DIR/zipalign" -v -p 4 \
            app/build/outputs/apk/release/app-release-unsigned.apk \
            app-release-aligned.apk

          "$BUILD_TOOLS_DIR/apksigner" sign \
            --ks release.jks \
            --ks-key-alias xundao \
            --ks-pass pass:123456 \
            --key-pass pass:123456 \
            --out "$GITHUB_WORKSPACE/com.xundao.clicker_v2.0.0_TimeSyncPro_Signed.apk" \
            app-release-aligned.apk

          cp app/build/outputs/apk/debug/app-debug.apk "$GITHUB_WORKSPACE/com.xundao.clicker_debug.apk"

      - name: 5. Upload Compiled APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: com.xundao.clicker-TimeSyncPro-APK
          path: |
            com.xundao.clicker_v2.0.0_TimeSyncPro_Signed.apk
            com.xundao.clicker_debug.apk
